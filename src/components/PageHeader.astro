---
const { crumb, title, subtitle } = Astro.props;
---
<header class="page-header">
  <div class="header-content">
    <div class="breadcrumb">
      <a href="/index.html">home</a>
      <span>/</span>
      <span>{crumb}</span>
    </div>
    <h1 class="page-title">{title}</h1>
    <p class="page-subtitle">{subtitle}</p>
  </div>
</header>
