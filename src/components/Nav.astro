---
const links = [
  { href: '/index.html', label: 'Home' },
  { href: '/projects.html', label: 'Projects' },
  { href: '/skills.html', label: 'Skills' },
  { href: '/experience.html', label: 'Experience' },
  { href: '/visits.html', label: 'Visits & Events' },
  { href: '/contact.html', label: 'Contact' },
  { href: '/flyer.html', label: 'Flyer' },
];

const { active } = Astro.props;
---
<nav class="nav-system">
  <a href="/index.html" class="nav-logo" aria-label="Home">
    <span class="logo-text">Max Simon</span><span class="logo-dot">.</span>
  </a>
  <div class="nav-links">
    {links.map((link) => (
      <a href={link.href} class:list={['nav-link', { active: link.label === active }]}>{link.label}</a>
    ))}
  </div>
  <button class="nav-hamburger" id="navHamburger" aria-label="Menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>
