---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Contact | Max Simon" active="Contact">
  <PageHeader crumb="contact" title="Contact" subtitle="Based in Luxembourg · BTS Cloud Computing" />

  <main class="contact-main">

    <div class="contact-left">
      <p class="contact-intro">I've just finished my 2nd semester of BTS Cloud Computing at Lycée Guillaume Kroll in Esch-Alzette. Email or LinkedIn works best — I check both regularly.</p>

      <div class="contact-channels">
        <a href="mailto:maxs4114@proton.me" class="channel-card">
          <div class="channel-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/>
              <path d="M2 8l10 7 10-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-platform">Email</span>
            <span class="channel-handle">maxs4114@proton.me</span>
          </div>
          <svg class="channel-arrow" width="16" height="16" viewBox="0 0 20 20" fill="none">
            <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>

        <a href="https://www.linkedin.com/in/max-simon-230757387/" target="_blank" rel="noopener" class="channel-card">
          <div class="channel-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="2" width="20" height="20" rx="3" stroke="currentColor" stroke-width="1.8"/>
              <line x1="8" y1="11" x2="8" y2="17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <circle cx="8" cy="7.5" r="1.2" fill="currentColor"/>
              <path d="M12 11v6M12 11c0 0 1-2 4-2 2 0 3 1.5 3 4v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-platform">LinkedIn</span>
            <span class="channel-handle">linkedin.com/in/max-simon-230757387</span>
          </div>
          <svg class="channel-arrow" width="16" height="16" viewBox="0 0 20 20" fill="none">
            <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>

        <a href="https://linktr.ee/max.simon" target="_blank" rel="noopener" class="channel-card">
          <div class="channel-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M12 4v10M9 7l3-3 3 3M6 17h12M6 20h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-platform">Linktree</span>
            <span class="channel-handle">linktr.ee/max.simon</span>
          </div>
          <svg class="channel-arrow" width="16" height="16" viewBox="0 0 20 20" fill="none">
            <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>
      </div>

      <div class="contact-cv-row">
        <span class="contact-cv-label">CV</span>
        <div class="contact-cv-links">
          <a href="/Downloads/devoTeam/FR%20CV%20Simon%20Max.pdf" target="_blank" class="cv-dl-btn">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none">
              <path d="M10 13V3M10 13l-3-3M10 13l3-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M3 17h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            Français
          </a>
          <a href="/Downloads/cv/EN-CV-Simon-Max.pdf" target="_blank" class="cv-dl-btn">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none">
              <path d="M10 13V3M10 13l-3-3M10 13l3-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M3 17h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            English
          </a>
        </div>
      </div>
    </div>

    <div class="contact-right">
      <div class="contact-photo-card">
        <img src="/img/me.jpg" alt="Max Simon" class="contact-photo" />
        <div class="contact-photo-name">Max Simon</div>
        <div class="contact-photo-role">Cloud Computing · BTS 2026</div>
      </div>

      <div class="contact-qr-card">
        <p class="contact-qr-label">Scan to connect on LinkedIn</p>
        <div class="contact-qr-wrap">
          <img src="/img/linkedin-qr.svg" alt="LinkedIn QR code" width="140" height="140" loading="lazy" />
        </div>
      </div>
    </div>

  </main>
</BaseLayout>
