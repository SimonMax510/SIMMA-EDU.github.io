---
import BaseLayout from '../layouts/BaseLayout.astro';
import projects from '../data/projects.json';
import skills from '../data/skills.json';

const projectCount = projects.length;
const featuredIds = ['project-lme', 'project-truenas', 'project-azure'];
const featured = featuredIds
  .map((id) => projects.find((p) => p.id === id))
  .filter(Boolean);
const homeCerts = skills.certificates;

// Short descriptions + tags for the featured cards on the home page.
const featuredMeta = {
  'project-lme': {
    desc: 'Co-founded web development & hosting company using Laravel, Proxmox and Coolify.',
    tags: ['Proxmox', 'Coolify'],
  },
  'project-truenas': {
    desc: 'Self-built NAS server — hardware assembly, TrueNAS installation, ZFS storage pools and self-hosted apps.',
    tags: ['TrueNAS', 'RAID', 'Hardware'],
  },
  'project-azure': {
    desc: 'Azure cloud lab — VM deployment, networking, auto-shutdown policies and cloud architecture visualisation.',
    tags: ['Azure', 'VMs', 'Networking'],
  },
};
---
<BaseLayout title="Max Simon | Cloud Computing" active="Home">

  <!-- Hero -->
  <main class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="title-line" style="animation-delay: 0.1s;">Max</span>
        <span class="title-line" style="animation-delay: 0.2s;">Simon<span class="logo-dot">.</span></span>
      </h1>

      <div class="hero-subtitle">
        <span class="subtitle-line" style="animation-delay: 0.4s;">Cloud Computing</span>
        <span class="subtitle-line" style="animation-delay: 0.5s;">BTS Student</span>
      </div>

      <p class="hero-description" style="animation-delay: 0.7s;">
        Hey, I'm Max — Cloud Computing student at Lycée Guillaume Kroll in Esch-Alzette.
        I've just finished my 2nd semester of BTS. Semester 2 deepened my focus on containerization with Docker,
        hypervisor management (VMware &amp; Proxmox), Azure administration (AZ-104), security &amp; incident
        response, and PowerShell/Bash automation. Outside of school I run a homelab and co-build
        Luxembourg Media Engineering with friends.
      </p>

      <div class="hero-cta" style="animation-delay: 0.9s;">
        <a href="/skills.html" class="cta-primary">
          <span>My Skills</span>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M4 10H16M16 10L10 4M16 10L10 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="/contact.html" class="cta-secondary">Get in touch</a>
      </div>

      <div class="cv-download-box" style="animation-delay: 1.1s;">
        <div class="cv-box-header">
          <svg width="13" height="13" viewBox="0 0 20 20" fill="none">
            <path d="M10 13L10 3M10 13L6 9M10 13L14 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M3 17H17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Download CV
        </div>
        <div class="cv-box-langs">
          <a href="/Downloads/devoTeam/FR%20CV%20Simon%20Max.pdf" target="_blank" class="cv-box-lang">Français</a>
          <div class="cv-box-divider"></div>
          <a href="/Downloads/cv/EN-CV-Simon-Max.pdf" target="_blank" class="cv-box-lang">English</a>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="visual-card" style="animation-delay: 0.3s;">
        <div class="card-image">
          <img src="/img/me.jpg" alt="Max Simon" />
        </div>
        <div class="card-stats">
          <div class="stat-item">
            <span class="stat-value">04</span>
            <span class="stat-label">Certificates</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-value">{String(projectCount).padStart(2, '0')}</span>
            <span class="stat-label">Projects</span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- About -->
  <section class="about-section">
    <div class="about-container">
      <div class="section-header">
        <h2 class="about-title">About Me</h2>
        <p class="about-subtitle">Getting to know the person behind the code</p>
      </div>

      <div class="about-text">
        <p class="about-intro">
          I started with an IT technician diploma, then followed my interest in
          cloud infrastructure deeper into a <span class="highlight">BTS Cloud Computing</span>.
          I learn by building: when something interests me, I set it up on real hardware
          and figure out how it works. That's how the homelab grew — from a TrueNAS server
          to a Kubernetes Pi cluster to a <span class="highlight">fully self-hosted AI stack</span>.
        </p>
        <p class="about-description">
          I like to understand how things actually work, not just use them.
          When something doesn't work as expected, I stay on it until I find out why.
          Outside of the technical side I'm working on
          <span class="highlight">LME</span> with friends, building and hosting real
          client projects in Luxembourg.
        </p>
      </div>

      <div class="about-strip">
        <div class="about-strip-item">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M10 2C6.686 2 4 4.686 4 8c0 4.5 6 10 6 10s6-5.5 6-10c0-3.314-2.686-6-6-6zm0 8a2 2 0 110-4 2 2 0 010 4z" fill="currentColor"/></svg>
          <div>
            <span class="about-strip-label">Location</span>
            <span class="about-strip-value">Luxembourg</span>
          </div>
        </div>
        <div class="about-strip-divider"></div>
        <div class="about-strip-item">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><rect x="3" y="4" width="14" height="13" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 2v4M13 2v4M3 9h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <div>
            <span class="about-strip-label">Born</span>
            <span class="about-strip-value">September 15, 2004</span>
          </div>
        </div>
        <div class="about-strip-divider"></div>
        <div class="about-strip-item">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M2 10h16M10 2c-2 3-3 5-3 8s1 5 3 8M10 2c2 3 3 5 3 8s-1 5-3 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <div>
            <span class="about-strip-label">Languages</span>
            <span class="about-strip-value">Luxembourgish · German · English · French</span>
          </div>
        </div>
        <div class="about-strip-divider"></div>
        <div class="about-strip-item">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><rect x="2" y="3" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M6 8h8M6 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <div>
            <span class="about-strip-label">Education</span>
            <span class="about-strip-value">BTS Cloud Computing</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="home-section">
    <div class="home-section-inner">
      <div class="home-section-header">
        <div>
          <span class="home-section-label">Portfolio</span>
          <h2 class="home-section-title">Favourite Projects</h2>
        </div>
        <a href="/projects.html" class="home-section-link">View all {projectCount} →</a>
      </div>
      <div class="home-projects-grid">
        {featured.map((project) => (
          <a href={`/projects.html#${project.id}`} class="home-project-card">
            <div class="hpc-top">
              <span class="hpc-course">{project.course}</span>
              <span class:list={['hpc-status', project.status.kind]}>{project.status.text}</span>
            </div>
            <h3 class="hpc-name">{project.name}</h3>
            <p class="hpc-desc">{featuredMeta[project.id].desc}</p>
            <div class="hpc-tags">
              {featuredMeta[project.id].tags.map((tag) => <span>{tag}</span>)}
            </div>
            <span class="hpc-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Skills -->
  <section class="home-section home-section-alt">
    <div class="home-section-inner">
      <div class="home-section-header">
        <div>
          <span class="home-section-label">Expertise</span>
          <h2 class="home-section-title">Technical Skills</h2>
        </div>
        <a href="/skills.html" class="home-section-link">View all →</a>
      </div>
      <div class="home-skills-grid">

        <a href="/skills.html" class="home-skill-card">
          <div class="hsk-icon">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="3" y="6" width="22" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/>
              <path d="M9 22H19M14 20V22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <rect x="7" y="10" width="5" height="4" rx="0.5" stroke="currentColor" stroke-width="1.5"/>
              <rect x="16" y="10" width="5" height="4" rx="0.5" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="hsk-content">
            <h3 class="hsk-name">Virtualization</h3>
            <p class="hsk-desc">Proxmox, VMware, Hyper-V, Docker, containerization and VM lifecycle management.</p>
            <div class="hsk-tags"><span>Proxmox</span><span>Docker</span><span>VMware</span></div>
          </div>
          <span class="hsk-arrow">→</span>
        </a>

        <a href="/skills.html" class="home-skill-card">
          <div class="hsk-icon">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 5C9 5 5 9 5 14C5 19 9 23 14 23C19 23 23 19 23 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M19 5L23 5L23 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M23 5L16 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <circle cx="14" cy="14" r="3" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="hsk-content">
            <h3 class="hsk-name">Azure</h3>
            <p class="hsk-desc">Microsoft Azure cloud services, virtual machines, networking, storage and AZ-900 certified.</p>
            <div class="hsk-tags"><span>Azure VMs</span><span>AZ-900</span></div>
          </div>
          <span class="hsk-arrow">→</span>
        </a>

        <a href="/skills.html" class="home-skill-card">
          <div class="hsk-icon">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <circle cx="6" cy="14" r="2.5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="22" cy="14" r="2.5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="14" cy="7" r="2.5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="14" cy="21" r="2.5" stroke="currentColor" stroke-width="1.8"/>
              <path d="M8.5 14H11.5M16.5 14H19.5M14 9.5V11.5M14 16.5V18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="hsk-content">
            <h3 class="hsk-name">Networking</h3>
            <p class="hsk-desc">TCP/IP, VLANs, firewall configuration, routing, switching and network infrastructure.</p>
            <div class="hsk-tags"><span>VLANs</span><span>Routing</span></div>
          </div>
          <span class="hsk-arrow">→</span>
        </a>

        <a href="/skills.html" class="home-skill-card">
          <div class="hsk-icon">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="4" y="4" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
              <rect x="15" y="4" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
              <rect x="4" y="15" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
              <rect x="15" y="15" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
            </svg>
          </div>
          <div class="hsk-content">
            <h3 class="hsk-name">Project Management</h3>
            <p class="hsk-desc">Agile workflows, task planning, team coordination and project documentation using modern tools.</p>
            <div class="hsk-tags"><span>Documentation</span><span>Google Drive</span><span>Teams</span></div>
          </div>
          <span class="hsk-arrow">→</span>
        </a>

      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="home-section home-section-alt">
    <div class="home-section-inner">
      <div class="home-section-header">
        <div>
          <span class="home-section-label">Credentials</span>
          <h2 class="home-section-title">Certifications</h2>
        </div>
        <a href="/skills.html" class="home-section-link">View all →</a>
      </div>
      <div class="home-certs-grid">
        {homeCerts.map((cert) => (
          <a href="/skills.html" class="home-cert-card">
            <img src={'/' + cert.img} alt={cert.title} class="home-cert-img" loading="lazy" />
            <div class="home-cert-info">
              <span class="home-cert-issuer">{cert.issuer}</span>
              <h4 class="home-cert-name">{cert.title}</h4>
              <span class="home-cert-badge active">Active</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Goals -->
  <section class="goals-section">
    <div class="goals-container">
      <div class="section-header">
        <h2 class="goals-title">Goals</h2>
        <p class="goals-subtitle">Short &amp; long-term professional objectives</p>
      </div>

      <div class="goals-grid">
        <a href="/goal-bts.html" class="goal-card">
          <div class="goal-icon"><img src="/img/cc.png" alt="Cloud Computing" /></div>
          <div class="goal-content">
            <h3 class="goal-title">BTS Progress</h3>
            <p class="goal-description">
              Successfully complete the BTS Cloud Computing program with excellent results,
              mastering cloud infrastructure, virtualization, and distributed systems to become
              a highly skilled cloud computing professional.
            </p>
          </div>
          <div class="goal-timeline">2025 - 2027</div>
          <div class="goal-arrow">→</div>
        </a>

        <a href="/goal-lme.html" class="goal-card">
          <div class="goal-icon"><img src="/img/lme/lme_logo.png" alt="LME" /></div>
          <div class="goal-content">
            <h3 class="goal-title">Build &amp; Lead LME</h3>
            <p class="goal-description">
              Develop Luxembourg Media Engineering into a registered company offering professional
              web development and hosting services. Co-lead the business to provide quality solutions
              to clients across Luxembourg and beyond.
            </p>
          </div>
          <div class="goal-timeline">Long-term</div>
          <div class="goal-arrow">→</div>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
